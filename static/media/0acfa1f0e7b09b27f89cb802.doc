<SCRIPT>
//var adini=false;
function hidediv(id)
{
	document.getElementById(id).style.display = 'none';

}
function showhide1(o,p) {
	var o1 = document.getElementById(o+'1');
	var o2 = document.getElementById(o+'2');
	if(o1 && o2){
		 o1.style.display=(p=='h')?'none':'block';
		 o2.style.display=(p=='h')?'block':'none';
	}
}
window.onload=function() {
	window.setTimeout("showhide1('float_r','h');showhide1('float_l','h')",10000);
}
</SCRIPT>


		<script type="text/javascript">
			$('.new-change a').on('mouseenter', function() {

				$('.new-change a').removeClass('current');
				$(this).addClass('current');

				$('.new-change-ul').hide();
				$('.new-change-ul').eq($(this).index()).show();

			});
			$('#newri_tit a').mouseover(function() {
				$('#newri_tit a').removeClass('current');
				$(this).addClass('current');

				$("#newri_con ul").hide();
				$("#newri_con ul").eq($(this).index()).show();
